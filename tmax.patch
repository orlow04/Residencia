@@ -39,6 +39,26 @@ from util.utils import LoggerCallback_Policy, save_model_fn
 import logzero
 from logzero import logger
 
+# Residência (controle da varredura do survival bonus): TMAX_LAMBDA=<x> faz o train_max, que é a escala da recompensa
+# no estado de treino (state_tracker2.py:231), ser o de uma execução com lambda_entropy = x. A recompensa não muda.
+# Sem a variável, o comportamento é idêntico ao original.
+_TMAX_LAMBDA = os.environ.get("TMAX_LAMBDA")
+
+
+def _tmax_ajusta(train_max, mapa, entropy_window, lambda_entropy):
+    """train_max = MAX_R - MIN_R contém lambda_entropy * (entropy_max - entropy_min) (simulated_env.py:81-82), com
+    entropy_min/max somados por termo da janela, como em prepare_envs. Troca esse termo pelo de TMAX_LAMBDA."""
+    if _TMAX_LAMBDA is None:
+        return train_max
+    faixa = 0
+    for termo in set(entropy_window):
+        valores = [v for k, v in mapa.items() if len(k) == termo]
+        faixa += max(valores) - min(valores)
+    novo = train_max + (float(_TMAX_LAMBDA) - lambda_entropy) * faixa
+    logger.info("TMAX_LAMBDA = {}: train_max {:.6f} -> {:.6f} (faixa da entropia {:.6f})".format(
+        _TMAX_LAMBDA, float(train_max), float(novo), float(faixa)))
+    return novo
+
