+# --- Residência (registro das trajetórias de avaliação) ------------------------------------------
+# TRAJ_LOG=<arquivo.csv>  grava, a cada época, cada passo das trajetórias de avaliação dos três protocolos
+# (FB, NX_0, NX_10): usuário, item e recompensa. Só lê o buffer do coletor; não consome números aleatórios.
+# Sem a variável, o comportamento é idêntico ao original. O arquivo não pode existir (evita misturar execuções).
+import atexit
+import os
+
+_TRAJ_LOG = os.environ.get("TRAJ_LOG")
+_traj_state = {"fh": None}
+
+
+def _traj_write(epoch, protocol, buffer, indices, lbe_item):
+    if _traj_state["fh"] is None:
+        if os.path.exists(_TRAJ_LOG) and os.path.getsize(_TRAJ_LOG) > 0:
+            raise RuntimeError(f"TRAJ_LOG={_TRAJ_LOG} já existe; use um arquivo novo para cada execução")
+        _traj_state["fh"] = open(_TRAJ_LOG, "w", buffering=1 << 16)
+        atexit.register(_traj_state["fh"].close)
+        _traj_state["fh"].write("epoch,protocolo,traj,t,user,item,item_raw,reward\n")
+    fh = _traj_state["fh"]
+    idx = np.array(indices, dtype=int)
+    live = np.ones(len(idx), dtype=bool)
+    t = 0
+    while live.any() and t < 1000:               # mesma caminhada de get_actions_feat
+        sel = np.flatnonzero(live)
+        cur = idx[sel]
+        user = np.asarray(buffer.obs[cur])[:, 0].astype(int)
+        act = np.asarray(buffer.act[cur]).reshape(-1).astype(int)
+        raw = lbe_item.inverse_transform(act) if lbe_item is not None else act
+        rew = np.asarray(buffer.rew[cur]).reshape(-1)
+        done = np.asarray(buffer.done[cur]).reshape(-1).astype(bool)
+        fh.write("".join(f"{epoch},{protocol},{j},{t},{u},{i},{r},{w!r}\n"
+                         for j, u, i, r, w in zip(sel, user, act, raw, rew.tolist())))
+        live[sel[done]] = False
+        idx[sel] = buffer.next(cur)
+        t += 1
+    fh.flush()
+# -------------------------------------------------------------------------------------------------
+
 
