+# --- Residência (diagnóstico do P_E) ------------------------------------------------------------
+# PE_LOG=<arquivo.csv>  grava, a cada passo de TREINO no ambiente simulado, o P_E e seus componentes.
+# PE_CONST=<valor>      (E2) substitui o P_E calculado por uma constante.
+# Sem as duas variáveis, o comportamento é idêntico ao original.
+import atexit
+import os
+
+_PE_LOG = os.environ.get("PE_LOG")
+_PE_CONST = os.environ.get("PE_CONST")
+_pe_state = {"fh": None, "n_envs": 0}
+
+
+def _pe_write(env, row):
+    if _pe_state["fh"] is None:
+        new = not os.path.exists(_PE_LOG) or os.path.getsize(_PE_LOG) == 0
+        _pe_state["fh"] = open(_PE_LOG, "a", buffering=1 << 16)
+        atexit.register(_pe_state["fh"].close)
+        if new:
+            _pe_state["fh"].write("env,turn,user,item,PE,n_ausentes,n_completados,PE_usado,r_hat,max_var,r_penalizado\n")
+    if not hasattr(env, "_pe_env_id"):
+        env._pe_env_id = _pe_state["n_envs"]
+        _pe_state["n_envs"] += 1
+    _pe_state["fh"].write(",".join(str(x) for x in (env._pe_env_id, *row)) + "\n")
+# -------------------------------------------------------------------------------------------------
+
 
